---
import type { Locale } from '../data/site';
import {
  achievements,
  copy,
  personalExperience,
  researchInterests,
} from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillTree from './SkillTree.astro';
import ContactCTA from './ContactCTA.astro';

const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
const experience = personalExperience[locale];
---

<BaseLayout locale={locale} title={t.aboutTitle} description={t.aboutLead}>
  <main id="main-content">
    <section class="section wrapper about-grid">
      <article class="about-panel education-panel">
        <span class="section-kicker">EXPERIENCE</span>
        <h1>{t.educationTitle}</h1>
        <ol class="experience-list">
          {experience.map((item) => <li><h2>{item.title}</h2><p>{item.detail}</p></li>)}
        </ol>
      </article>
      <article class="about-panel interest-panel">
        <span class="section-kicker">RESEARCH</span>
        <h2>{t.interestsTitle}</h2>
        <ul class="interest-list">
          {researchInterests.map((interest, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{interest[locale]}</strong></li>
          ))}
        </ul>
      </article>
    </section>

    <div class="wrapper"><SkillTree locale={locale} /></div>

    <section class="section wrapper timeline-section" aria-labelledby="timeline-title">
      <div class="section-heading">
        <span class="section-kicker">FULL TIMELINE</span>
        <h2 id="timeline-title">{t.timelineTitle}</h2>
      </div>
      <ol class="timeline" tabindex="0" aria-label={locale === 'zh' ? '个人经历时间线，可横向滚动' : 'Personal experience timeline, horizontally scrollable'}>
        {achievements.map((item) => (
          <li>
            <time>{item.year}</time>
            <span class:list={['timeline-dot', `type-${item.type}`]} aria-hidden="true"></span>
            <div><h3>{item[locale].title}</h3><p>{item[locale].meta}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <div class="wrapper"><ContactCTA locale={locale} /></div>
  </main>
</BaseLayout>
