---
import type { Locale } from '../data/site';
import {
  achievements,
  copy,
  education,
  researchInterests,
} from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import SkillTree from './SkillTree.astro';
import ContactCTA from './ContactCTA.astro';

const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
const edu = education[locale];
---

<BaseLayout locale={locale} title={t.aboutTitle} description={t.aboutLead}>
  <main id="main-content">
    <section class="about-hero wrapper">
      <div class="about-hero__copy">
        <span class="section-kicker">ABOUT · 郭艾咏</span>
        <h1>{t.aboutLead}</h1>
        <p>{t.aboutBody}</p>
      </div>
      <ResponsiveImage
        class="about-portrait"
        src="/assets/portrait.webp"
        alt={locale === 'zh' ? '郭艾咏的完整机器人主题漫画肖像' : 'Full robotics-themed illustrated portrait of Aiyong Guo'}
        loading="eager"
        fetchpriority="high"
        sizes="(min-width: 900px) 42vw, 100vw"
      />
    </section>

    <section class="section wrapper about-grid">
      <article class="about-panel education-panel">
        <span class="section-kicker">EDUCATION</span>
        <h2>{t.educationTitle}</h2>
        <h3>{edu.school}</h3>
        <p>{edu.degree}</p>
        <p class="education-detail">{edu.detail}</p>
        <p class="muted">{edu.courses}</p>
      </article>
      <article class="about-panel interest-panel">
        <span class="section-kicker">RESEARCH</span>
        <h2>{t.interestsTitle}</h2>
        <ul class="interest-list">
          {researchInterests.map((interest, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{interest[locale]}</strong></li>
          ))}
        </ul>
      </article>
    </section>

    <div class="wrapper"><SkillTree locale={locale} /></div>

    <section class="section wrapper timeline-section" aria-labelledby="timeline-title">
      <div class="section-heading">
        <span class="section-kicker">FULL TIMELINE</span>
        <h2 id="timeline-title">{t.timelineTitle}</h2>
      </div>
      <ol class="timeline">
        {achievements.map((item) => (
          <li>
            <time>{item.year}</time>
            <span class:list={['timeline-dot', `type-${item.type}`]} aria-hidden="true"></span>
            <div><h3>{item[locale].title}</h3><p>{item[locale].meta}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <div class="wrapper"><ContactCTA locale={locale} /></div>
  </main>
</BaseLayout>
