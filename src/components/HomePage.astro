---
import { getCollection } from 'astro:content';
import type { Locale } from '../data/site';
import {
  achievements,
  copy,
  email,
  localePath,
  proofPoints,
} from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import ProjectCard from './ProjectCard.astro';
import SkillTree from './SkillTree.astro';
import ContactCTA from './ContactCTA.astro';

const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout locale={locale}>
  <main id="main-content">
    <section class="hero wrapper">
      <div class="hero__copy">
        <span class="hero__eyebrow">{t.heroEyebrow}</span>
        <p class="hero__name">{t.heroTitle}</p>
        <h1>{t.heroHeadline}</h1>
        <p class="hero__body">{t.heroBody}</p>
        <ul class="role-list" aria-label={locale === 'zh' ? '专业方向' : 'Focus areas'}>
          {t.heroRoles.map((role) => <li>{role}</li>)}
        </ul>
        <div class="button-row">
          <a class="button primary" href={localePath(locale, '/projects/')}>{t.viewProjects} <span aria-hidden="true">↗</span></a>
          <a class="button secondary" href={`mailto:${email}`}>{t.contactMe}</a>
          <button class="button disabled" type="button" disabled title={t.resumePending}>{t.resumePending}</button>
        </div>
      </div>
      <div class="hero__visual">
        <div class="hero__halo" aria-hidden="true"></div>
        <ResponsiveImage
          class="hero__portrait"
          src="/assets/portrait.webp"
          alt={locale === 'zh' ? '郭艾咏站在机器人与智能系统实验环境中的漫画肖像' : 'Illustrated portrait of Aiyong Guo in a robotics and intelligent systems workspace'}
          loading="eager"
          fetchpriority="high"
          sizes="(min-width: 900px) 42vw, 90vw"
          position="50% 35%"
        />
        <div class="hero__note note-one">
          <span aria-hidden="true">✦</span>
          <div><small>{locale === 'zh' ? '当前方向' : 'Current direction'}</small><strong>{locale === 'zh' ? '具身智能 · VLA' : 'Embodied AI · VLA'}</strong></div>
        </div>
        <div class="hero__note note-two">
          <span class="status-dot" aria-hidden="true"></span>
          <div><small>{locale === 'zh' ? '开放交流' : 'Open to connect'}</small><strong>{locale === 'zh' ? '机器人研究' : 'Robotics research'}</strong></div>
        </div>
      </div>
    </section>

    <section class="proof wrapper" aria-labelledby="proof-title">
      <div class="proof__intro">
        <span class="section-kicker">AT A GLANCE</span>
        <h2 id="proof-title">{t.proofTitle}</h2>
      </div>
      <dl class="proof__grid">
        {proofPoints.map((point) => (
          <div><dt>{point[locale]}</dt><dd>{point.value}</dd></div>
        ))}
      </dl>
    </section>

    <section class="section wrapper projects-section" aria-labelledby="featured-projects">
      <div class="section-heading split-heading">
        <div>
          <span class="section-kicker">SELECTED WORK</span>
          <h2 id="featured-projects">{t.featuredProjects}</h2>
        </div>
        <div>
          <p>{t.featuredProjectsBody}</p>
          <a class="text-link" href={localePath(locale, '/projects/')}>{t.allProjects} <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="project-grid project-grid--featured">
        {projects.map((project, index) => <ProjectCard project={project} locale={locale} featured={index === 0} />)}
      </div>
    </section>

    <div class="wrapper"><SkillTree locale={locale} /></div>

    <section class="section wrapper achievement-section" aria-labelledby="achievement-title">
      <div class="section-heading split-heading">
        <div>
          <span class="section-kicker">MILESTONES</span>
          <h2 id="achievement-title">{t.achievementsTitle}</h2>
        </div>
        <div><p>{t.achievementsBody}</p></div>
      </div>
      <ol class="achievement-list">
        {achievements.slice(0, 6).map((item, index) => (
          <li>
            <span class="achievement-index">{String(index + 1).padStart(2, '0')}</span>
            <div><h3>{item[locale].title}</h3><p>{item[locale].meta}</p></div>
            <time>{item.year}</time>
          </li>
        ))}
      </ol>
      <div class="section-tail">
        <a class="text-link" href={localePath(locale, '/about/')}>{locale === 'zh' ? '了解更多经历' : 'Explore the full story'} <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <div class="wrapper"><ContactCTA locale={locale} /></div>
  </main>
</BaseLayout>
