---
import { getCollection } from 'astro:content';
import type { Locale } from '../data/site';
import {
  copy,
  localePath,
  proofPoints,
  personalExperience,
} from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import ProjectCard from './ProjectCard.astro';
import SkillTree from './SkillTree.astro';
import ContactCTA from './ContactCTA.astro';

const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
const experience = personalExperience[locale];
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout locale={locale}>
  <main id="main-content">
    <section class="hero wrapper">
      <h1 class="page-title">{t.heroTitle}</h1>
      <div class="hero__copy">
        <span class="hero__eyebrow">{t.heroEyebrow}</span>
        <h2>{t.heroHeadline}</h2>
        <div class="hero__body">
          <p class="hero__experience-label">{locale === 'zh' ? '个人经历：' : 'Personal experience:'}</p>
          {experience.map((item) => <p><strong>{item.title}</strong>{locale === 'zh' ? '：' : ': '}{item.detail}</p>)}
          <a class="button secondary button--compact" href={localePath(locale, '/about/')}>{locale === 'zh' ? '经历详情' : 'Experience details'} <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="hero__visual">
        <div class="hero__halo" aria-hidden="true"></div>
        <ResponsiveImage
          class="hero__portrait"
          src="/assets/portrait.webp"
          alt={locale === 'zh' ? '郭艾咏站在机器人与智能系统实验环境中的漫画肖像' : 'Illustrated portrait of Aiyong Guo in a robotics and intelligent systems workspace'}
          loading="eager"
          fetchpriority="high"
          sizes="(min-width: 900px) 42vw, 90vw"
          position="50% 35%"
        />
        <div class="hero__note note-one">
          <span aria-hidden="true">✦</span>
          <div><small>{locale === 'zh' ? '当前方向' : 'Current direction'}</small><strong>{locale === 'zh' ? '具身智能 · VLA' : 'Embodied AI · VLA'}</strong></div>
        </div>
        <div class="hero__note note-two">
          <span class="status-dot" aria-hidden="true"></span>
          <div><small>{locale === 'zh' ? '开放交流' : 'Open to connect'}</small><strong>{locale === 'zh' ? '机器人研究' : 'Robotics research'}</strong></div>
        </div>
      </div>
    </section>

    <section class="proof wrapper" aria-labelledby="proof-title">
      <div class="proof__intro">
        <span class="section-kicker">AT A GLANCE</span>
        <h2 id="proof-title">{t.proofTitle}</h2>
      </div>
      <dl class="proof__grid">
        {proofPoints.map((point) => (
          <div><dt>{point[locale]}</dt><dd>{point.value}</dd></div>
        ))}
      </dl>
    </section>

    <div class="wrapper"><SkillTree locale={locale} /></div>

    <section class="section wrapper projects-section" aria-labelledby="featured-projects">
      <div class="section-heading split-heading">
        <div>
          <span class="section-kicker">SELECTED WORK</span>
          <h2 id="featured-projects">{t.featuredProjects}</h2>
        </div>
        <div>
          <p>{t.featuredProjectsBody}</p>
          <a class="text-link" href={localePath(locale, '/projects/')}>{t.allProjects} <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="project-grid project-grid--featured">
        {projects.map((project, index) => <ProjectCard project={project} locale={locale} featured={index === 0} interactive={false} useResumeSummary />)}
      </div>
    </section>

    <div class="wrapper"><ContactCTA locale={locale} /></div>
  </main>
</BaseLayout>
