---
import type { Locale } from '../data/site';
import { copy, email, github, localePath } from '../data/site';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const t = copy[locale];
const zhEquivalent = locale === 'zh' ? currentPath : currentPath.replace(/^\/en(?=\/|$)/, '') || '/';
const alternate = locale === 'zh' ? (currentPath === '/' ? '/en/' : `/en${currentPath}`) : zhEquivalent;
const links = [
  { label: t.nav.home, path: localePath(locale, '/') },
  { label: t.nav.projects, path: localePath(locale, '/projects/') },
  { label: t.nav.about, path: localePath(locale, '/about/') },
];
const normalize = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const isCurrent = (path: string) => {
  const normalized = normalize(path);
  if (normalized === '/' || normalized === '/en/') return currentPath === normalized;
  return currentPath.startsWith(normalized);
};
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={localePath(locale, '/')} aria-label={locale === 'zh' ? '郭艾咏首页' : 'Aiyong Guo home'}>
      <span class="brand-mark" aria-hidden="true">Ai_Y</span>
      <span>{locale === 'zh' ? '郭艾咏' : 'Aiyong Guo'}</span>
    </a>

    <button
      class="menu-button"
      type="button"
      aria-controls="primary-navigation"
      aria-expanded="false"
      aria-label={t.openMenu}
      data-menu-button
      data-open-label={t.openMenu}
      data-close-label={t.closeMenu}
    >
      <span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>

    <div class="site-nav" id="primary-navigation" data-menu data-open="false">
      <nav aria-label={locale === 'zh' ? '主要导航' : 'Primary navigation'}>
        <ul class="nav-links">
          {links.map((link) => (
            <li>
              <a href={link.path} aria-current={isCurrent(link.path) ? 'page' : undefined}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="header-actions">
        <a class="icon-link language-link" href={alternate} lang={locale === 'zh' ? 'en' : 'zh-CN'} title={t.languageLabel}>
          {t.languageCode}<span class="sr-only">{t.languageLabel}</span>
        </a>
        <button class="icon-link" type="button" data-theme-toggle aria-label={t.themeToggle} aria-pressed="false">
          <span data-theme-icon aria-hidden="true">☀</span>
        </button>
        <a class="icon-link github-link" href={github} target="_blank" rel="noreferrer" aria-label="GitHub">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path fill="currentColor" d="M12 .6a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.4.7-4.1-1.5-4.1-1.5-.5-1.4-1.3-1.8-1.3-1.8-1.1-.8.1-.8.1-.8 1.2.1 1.9 1.2 1.9 1.2 1.1 1.9 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.4-5.5-6a4.7 4.7 0 0 1 1.2-3.3c-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.9.1 3.2a4.7 4.7 0 0 1 1.2 3.3c0 4.6-2.8 5.7-5.5 6 .4.3.8 1 .8 2v2.9c0 .3.2.7.8.6A12 12 0 0 0 12 .6Z"/></svg>
        </a>
        <a class="email-link" href={`mailto:${email}`}>{email}</a>
      </div>
    </div>
  </div>
</header>
